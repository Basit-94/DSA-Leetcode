public static int minMeetingRooms(int[][] intervals) {

        int n = intervals.length,i=0;
        int s[] = new int[n];
        int e[] = new int[n];

        for(i=0;i<n;i++)
        {
            s[i] = intervals[i][0];
            e[i] = intervals[i][1];
        }

        Arrays.sort(s);
        Arrays.sort(e);

        int j=0,c=0,result=0;
        i=0;
        while(i<n && j<n)
        {
            while(i<n && j<n && s[i]<e[j])
            {
                c++;
                i++;
            }
            result = Math.max(result,c);
            while(j<n && i<n && e[j]<s[i])
            {
                c--;
                j++;
            }
        }
        
        return result;
    }
