class Solution {
    
    static class Pair {
    int first,second;
    Pair(int first,int second) {
        this.first = first;
        this.second = second;
    }
    }
    
    public boolean isCycle(int V, int[][] edges) {
        // Code here
        ArrayList<ArrayList<Integer>> adj = new ArrayList<>();
        
        for(int i=0;i<V;i++) {
            adj.add(new ArrayList<>());
        }
        for(int i=0;i<edges.length;i++) {
            int a = edges[i][0];
            int b = edges[i][1];
            adj.get(a).add(b);
            adj.get(b).add(a);
        }
        
        int vis[] = new int[V];
        for(int i=0;i<vis.length;i++) {
            if(vis[i]==0) {
                if(bfs(i,vis,adj)) {
                    return true;
                }
            }
        }
        
        return false;
    }

static boolean bfs(int i,int vis[],ArrayList<ArrayList<Integer>> adj) {
    Queue<Pair> q = new LinkedList<>();
    q.add(new Pair(i,-1));
    vis[i] = 1;
    
    while(!q.isEmpty()) {
        int node = q.peek().first;
        int parent = q.peek().second;
        q.remove();
        
        for(int a : adj.get(node)) {
            if(vis[a]==0) {
                vis[a] = 1;
                q.add(new Pair(a,node));
            }
            else if(a!=parent) {
                return true;
            }
        }
    }
    
    return false;
}

}
